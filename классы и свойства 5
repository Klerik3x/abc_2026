# Создайте в одном скрипте классы Product(name, price) и Order(). У товара свойства name и price позволяют чтение и запись, отрицательная цена заменяется нулём.

# Заказ хранит список экземпляров товаров в products. Метод add_product(product) добавляет товар, remove_product(product) удаляет одно его вхождение, если оно есть. Свойство total_price доступно для чтения и каждый раз вычисляет сумму текущих цен товаров. Пустой заказ стоит 0.

# Добавьте пример: положите в заказ книгу за 10 и ручку за 2, выведите общую стоимость.

# Напишите решение
class Product:
    def __init__(self, name, price):
        self.name = name
        self.price = price  # через сеттер — проверка отрицательности

    @property
    def name(self):
        return self._name

    @name.setter
    def name(self, value):
        self._name = value

    @property
    def price(self):
        return self._price

    @price.setter
    def price(self, value):
        self._price = 0 if value < 0 else value


class Order:
    def __init__(self):
        self.products = []

    def add_product(self, product):
        self.products.append(product)

    def remove_product(self, product):
        if product in self.products:
            self.products.remove(product)

    @property
    def total_price(self):
        return sum(p.price for p in self.products)


order = Order()
order.add_product(Product('Book', 10))
order.add_product(Product('Pen', 2))
print(order.total_price)
