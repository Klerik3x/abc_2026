# Создайте класс Temperature(celsius) со свойствами celsius, fahrenheit и kelvin для чтения и записи. Внутри экземпляра храните только температуру в градусах Цельсия; значения других шкал вычисляйте.

# Формулы: F = C·9/5 + 32, K = C + 273.15. Изменение любого свойства должно сразу отражаться в двух остальных.

# Добавьте пример: создайте температуру 25 °C, выведите значения Цельсия, Фаренгейта и Кельвина, установите 32 °F и снова выведите Цельсии. Выводите только числа, разделяя их пробелами или переводами строк.

class Temperature:
    def __init__(self, celsius=0):
        self._celsius = celsius

    @property
    def celsius(self):
        return self._celsius

    @celsius.setter
    def celsius(self, value):
        self._celsius = value

    @property
    def fahrenheit(self):
        return self._celsius * 9 / 5 + 32

    @fahrenheit.setter
    def fahrenheit(self, value):
        self._celsius = (value - 32) * 5 / 9

    @property
    def kelvin(self):
        return self._celsius + 273.15

    @kelvin.setter
    def kelvin(self, value):
        self._celsius = value - 273.15


t = Temperature(25)
print(t.celsius, t.fahrenheit, t.kelvin)
t.fahrenheit = 32
print(t.celsius)
